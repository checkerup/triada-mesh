# ============================================================
# Triada Mesh — Environment Configuration Template
# Copy this file to .env and supply your local settings.
# ZERO SECRETS POLICY: Never commit .env or API keys to git!
# ============================================================

# Root storage directory (defaults to ~/.triada if omitted)
TRIADA_ROOT=~/.triada

# Custom Obsidian Vault path (defaults to $TRIADA_ROOT/vault)
# TRIADA_VAULT_DIR=/path/to/your/obsidian/vault

# Jev Arbiter System One Endpoint & API Keys
# You can provide multiple comma-separated keys for automatic rotation:
TRIADA_JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
TRIADA_JEV_API_KEY=your_typesafe_jev_api_key_here

# Provider selection: 'env' (default) or custom import path to KeyPoolProvider
TRIADA_JEV_PROVIDER=env

# Polling and Grace Period Settings (Seconds)
TRIADA_PACER_POLL_SEC=20
TRIADA_GRACE_MIN_SEC=15
TRIADA_GRACE_MAX_SEC=30

# Telegram Notifications for Kill-Switch Alerts (Optional)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Logging level (DEBUG, INFO, WARNING, ERROR)
TRIADA_LOG_LEVEL=INFO
